{
  "version": 2,
  "buildCommand": "npm --prefix smart-event-management-system/frontend install && npm --prefix smart-event-management-system/frontend run build",
  "outputDirectory": "smart-event-management-system/frontend/dist",
  "functions": {
    "api/**/*.py": {
      "includeFiles": "{smart-event-management-system/backend/**,smart-event-management-system/frontend/dist/**}",
      "excludeFiles": "{**/node_modules/**,**/venv/**,**/.venv/**,**/__pycache__/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py?__route=/$1"
    }
  ]
}
