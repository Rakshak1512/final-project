# ------------------------------------------------------------------
# EventSphere - Backend Environment Variables Template (.env.example)
# Copy this file to .env and supply your local or production credentials.
# NEVER commit your real .env file or private credentials to GitHub.
# ------------------------------------------------------------------

# Application
APP_NAME=EventSphere
APP_ENV=development
DEBUG=True

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000

# Security / JWT (Generate a secure random secret for production)
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars-minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Firebase / Firestore (Database & Storage)
FIREBASE_CREDENTIALS_PATH=./firebase_credentials.json
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=""

# Email Delivery - Primary: Resend HTTP REST API
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
# Resend sandbox default is onboarding@resend.dev (sends only to your registered Resend email).
# For unrestricted sending, add and verify your custom domain at resend.com/domains:
RESEND_FROM_EMAIL=onboarding@resend.dev

# Secondary / Optional: Gmail SMTP (if EMAIL_PROVIDER is set to "smtp")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_FROM_NAME=EventSphere
SMTP_FROM_EMAIL=your_smtp_user@gmail.com
SMTP_USE_TLS=True

# AI Chatbot (Google Gemini or OpenAI)
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# OTP Settings
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# File Uploads
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=uploads

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
