# ===================================================================
# EventSphere - Backend Environment Configuration Template
# ===================================================================
# Copy this file to ".env" in the backend directory and configure your values.
# NEVER commit the actual ".env" file containing real secrets to version control.

# -------------------------------------------------------------------
# Application Settings
# -------------------------------------------------------------------
APP_NAME=EventSphere
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# -------------------------------------------------------------------
# Frontend & Backend URLs
# -------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# -------------------------------------------------------------------
# Security / JWT
# -------------------------------------------------------------------
# Generate a strong secret key (e.g. openssl rand -hex 32)
SECRET_KEY=generate_a_secure_random_32_byte_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------------------------------
# Database (Firebase Firestore)
# -------------------------------------------------------------------
# Option A: Individual Firebase Service Account Environment Variables
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Paste the private key including -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY-----
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app

# Option B: Local Service Account JSON Credentials File:
# FIREBASE_CREDENTIALS_PATH=./firebase_credentials.json

# -------------------------------------------------------------------
# Email Delivery (Resend HTTP API)
# -------------------------------------------------------------------
# Resend API Key from https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender email or domain (e.g. "onboarding@resend.dev" for testing, or your verified domain)
RESEND_FROM_EMAIL=onboarding@resend.dev
EMAIL_PROVIDER=resend

# -------------------------------------------------------------------
# AI Chatbot Configuration
# -------------------------------------------------------------------
# Supported AI Providers: gemini, openai
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
# Google Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# OpenAI API key (optional alternative) from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# -------------------------------------------------------------------
# OTP Settings
# -------------------------------------------------------------------
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# -------------------------------------------------------------------
# Uploads
# -------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=uploads

# -------------------------------------------------------------------
# CORS Configuration
# -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -------------------------------------------------------------------
# Rate Limiting
# -------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60

# -------------------------------------------------------------------
# Demo / Seed Accounts
# -------------------------------------------------------------------
# Set true only when you want demo seed accounts provisioned on startup.
SEED_TEST_USERS=false
